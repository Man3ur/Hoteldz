# Copier ce fichier en .env puis renseigner les clés quand vous branchez vos API.
# Météo : Open-Meteo fonctionne sans clé. Pour OpenWeatherMap, mettez votre clé ici.
VITE_WEATHER_PROVIDER=open-meteo
VITE_OPENWEATHER_API_KEY=
# Lieux : "demo" (données intégrées) ou "api" (votre backend)
VITE_PLACES_SOURCE=demo
VITE_PLACES_API_URL=
# Fond de carte (tuiles). Par défaut CARTO Voyager, gratuit avec attribution.
VITE_MAP_TILES_URL=
